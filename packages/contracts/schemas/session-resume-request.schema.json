{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.master-support.invalid/protocol/1.0/session-resume-request.schema.json",
  "title": "SessionResumeRequest",
  "type": "object",
  "required": ["protocolVersion", "messageId", "messageType", "sessionId", "timestamp", "payload"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "const": "session.resume.request" },
    "sessionId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["agentInstanceId"],
      "properties": {
        "agentInstanceId": { "type": "string", "format": "uuid" },
        "resumeToken": { "type": "string", "minLength": 32 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
