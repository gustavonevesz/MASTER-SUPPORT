{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.master-support.invalid/protocol/1.0/protocol-error.schema.json",
  "title": "ProtocolError",
  "type": "object",
  "required": ["protocolVersion", "messageId", "messageType", "timestamp", "payload"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "const": "protocol.error" },
    "correlationId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["unsupported_protocol", "invalid_message", "incompatible_agent"] },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
