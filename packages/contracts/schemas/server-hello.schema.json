{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.master-support.invalid/protocol/1.0/server-hello.schema.json",
  "title": "ServerHello",
  "type": "object",
  "required": ["protocolVersion", "messageId", "messageType", "sessionId", "correlationId", "timestamp", "expiresAt", "payload"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "const": "server.hello" },
    "sessionId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["serverVersion", "selectedProtocolVersion", "compatibility", "createdAt", "heartbeatIntervalSeconds", "negotiatedCapabilities", "developmentOnly"],
      "properties": {
        "serverVersion": { "type": "string", "minLength": 1 },
        "selectedProtocolVersion": { "const": "1.0" },
        "compatibility": { "enum": ["compatible"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "heartbeatIntervalSeconds": { "type": "integer" },
        "resumeToken": { "type": "string", "minLength": 32 },
        "resumeTicket": { "type": "string", "minLength": 32 },
        "resumeTicketExpiresAt": { "type": "string", "format": "date-time" },
        "authentication": { "enum": ["support_invitation"] },
        "negotiatedCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "version"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "developmentOnly": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
