{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.master-support.invalid/protocol/1.0/session-close.schema.json",
  "title": "SessionClose",
  "type": "object",
  "required": ["protocolVersion", "messageId", "messageType", "sessionId", "timestamp", "payload"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "const": "session.close" },
    "sessionId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": { "type": "object", "additionalProperties": false }
  },
  "additionalProperties": false
}
