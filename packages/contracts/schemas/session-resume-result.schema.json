{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.master-support.invalid/protocol/1.0/session-resume-result.schema.json",
  "title": "SessionResumeResult",
  "type": "object",
  "required": ["protocolVersion", "messageId", "messageType", "sessionId", "correlationId", "timestamp", "expiresAt", "payload"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "const": "session.resume.result" },
    "sessionId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["accepted", "developmentOnly"],
      "properties": {
        "accepted": { "type": "boolean" },
        "developmentOnly": { "type": "boolean" },
        "resumeTicket": { "type": "string", "minLength": 32 },
        "resumeTicketExpiresAt": { "type": "string", "format": "date-time" },
        "authentication": { "enum": ["support_invitation"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
