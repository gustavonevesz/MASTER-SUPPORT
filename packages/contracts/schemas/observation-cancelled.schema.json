{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.master-support.invalid/protocol/1.0/observation-cancelled.schema.json",
  "title": "ObservationCancelled",
  "type": "object",
  "required": ["protocolVersion", "messageId", "messageType", "sessionId", "correlationId", "timestamp", "payload"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "const": "observation.cancelled" },
    "sessionId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["requestId", "status"],
      "properties": {
        "requestId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["cancelled", "already_terminal", "not_found"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
