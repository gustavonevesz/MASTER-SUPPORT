{
  "name": "@master-support/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "node --import tsx --test test/*.test.ts ../../tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
