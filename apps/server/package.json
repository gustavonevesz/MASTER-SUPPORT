{
  "name": "@master-support/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "db:migrate": "tsx src/persistence/migrate-cli.ts",
    "db:validate-test": "tsx src/persistence/validate-test-database-cli.ts",
    "support:invite": "tsx src/trust/invite-cli.ts",
    "support:revoke-invite": "tsx src/trust/revoke-cli.ts",
    "test": "node --import tsx --test test/*.test.ts ../../tests/integration/*.test.ts ../../tests/spikes/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "pg": "^8.16.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "8.18.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
