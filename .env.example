# Development-only example. Use dedicated databases and replace all values locally.
MASTER_SUPPORT_DATABASE_URL=postgresql://master_support_app:change-me@127.0.0.1:5432/master_support_dev
MASTER_SUPPORT_TEST_DATABASE_URL=postgresql://master_support_test:change-me@127.0.0.1:5432/master_support_test
MASTER_SUPPORT_MODE=secure
MASTER_SUPPORT_HOST=127.0.0.1
MASTER_SUPPORT_PORT=3000
MASTER_SUPPORT_TLS_CERT_PATH=C:\\replace-me\\server-certificate.pem
MASTER_SUPPORT_TLS_KEY_PATH=C:\\replace-me\\server-private-key.pem
MASTER_SUPPORT_INVITATION_TTL_MS=600000
MASTER_SUPPORT_CONNECTION_TICKET_TTL_MS=60000
MASTER_SUPPORT_RESUME_TICKET_TTL_MS=300000
MASTER_SUPPORT_SESSION_LEASE_MS=15000
